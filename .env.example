NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_AUTH_PROVIDERS=email,google,github
# Where public roadmaps are served, e.g. https://acta.page. Unset, they live at /p/<workspace>/<board>.
NEXT_PUBLIC_PUBLIC_ORIGIN=
# Optional: the Acta GitHub App. See "GitHub" in the README.
GITHUB_APP_ID=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Optional: tokens from Google Search Console and Bing Webmaster Tools, to prove the site is yours.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
